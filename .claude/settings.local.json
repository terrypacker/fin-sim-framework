{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "LS",
      "WebSearch",
      "Bash(make test:*)",
      "Bash(node --test tests/simulation.test.mjs)",
      "Bash(node:*)",
      "Bash(awk '{print $NF}')",
      "Bash(xargs -I {} sh -c 'echo \"=== {} ===\" && head -50 {}')",
      "Bash(find:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(git stash:*)",
      "Bash(grep:*)",
      "Bash(npx:*)",
      "Bash(gtimeout 30 node --test tests/unit/intl-retirement-scenario.test.mjs)",
      "Bash(echo \"EXIT: $?\")",
      "Bash(NODE_OPTIONS=--experimental-vm-modules npx jest *)",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__performance_start_trace",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__click",
      "mcp__chrome-devtools__performance_analyze_insight",
      "mcp__chrome-devtools__evaluate_script",
      "Bash(python3 -c \"import openpyxl; print\\('openpyxl available'\\)\")",
      "Bash(python3 -c \"import xlrd; print\\('xlrd available'\\)\")",
      "Bash(pip3 install *)",
      "Bash(python3 *)",
      "Bash(sort -t- -k2 -n)",
      "Bash(xargs ls *)",
      "Bash(xargs cat *)",
      "mcp__chrome-devtools__navigate_page",
      "Bash(git *)",
      "mcp__chrome-devtools__performance_stop_trace",
      "Bash(sort -t: -k2 -rn)",
      "mcp__chrome-devtools__new_page",
      "mcp__chrome-devtools__get_console_message",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__list_network_requests",
      "Bash(rollup *)",
      "Bash(awk '{print $5, $6, $7, $8}')",
      "Bash(npm install *)",
      "Bash(npm ls *)",
      "Bash(xargs -I {} basename {})",
      "Bash(awk -F\"'\" '{print $2}')",
      "Bash(gtimeout 5 node --test \"tests/unit/account.test.mjs\")",
      "Bash(echo \"FAIL/TIMEOUT \\($?\\)\")",
      "Bash(awk '{print $3}')",
      "Bash(lsof -iTCP:5173 -sTCP:LISTEN)",
      "mcp__chrome-devtools__wait_for",
      "Bash(CLAUDE_CODE_TMPDIR=/tmp grep *)",
      "Bash(TMPDIR=/tmp find *)",
      "Bash(export CLAUDE_CODE_TMPDIR=/tmp)",
      "Bash(export TMPDIR=/tmp)",
      "Bash(curl -s --max-time 3 http://localhost:9222/json)",
      "Bash(curl -s --max-time 3 http://localhost:10001/index.html)",
      "Bash(curl -s --max-time 3 -o /dev/null -w \"%{http_code}\" http://localhost:10001/src/main.js)",
      "Bash(JOURNAL_STRICT=on node --test \"tests/unit/**/*.test.mjs\")",
      "WebFetch(domain:www.ato.gov.au)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/read-once/hook.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/read-once/compact.sh"
          }
        ]
      }
    ]
  }
}
