{
  "name": "@terrypacker/financial-sim",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "module": "dist-lib/index.esm.js",
  "exports": {
    ".": {
      "import": "./dist-lib/index.esm.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:all": "npm run build && npm run build:lib",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-lib",
    "build:index": "node scripts/build-index.js",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:viz": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test": "npm run test:unit && npm run test:viz",
    "test:all": "npm run test:unit && npm run test:viz",
    "requirements": "node scripts/check-requirements.js",
    "requirements:missing": "node scripts/check-requirements.js --missing"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.2",
    "@babel/parser": "^7.29.2",
    "echarts": "^6.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "vite": "^8.0.14"
  }
}
