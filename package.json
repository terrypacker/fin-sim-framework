{
  "name": "@terrypacker/financial-sim",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "module": "dist-lib/index.esm.js",
  "exports": {
    ".": {
      "import": "./dist-lib/index.esm.js"
    }
  },
  "scripts": {
    "dev": "JOURNAL_STRICT=on vite",
    "prod": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:all": "npm run build && npm run build:lib",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-lib",
    "build:index": "node scripts/dev/build-index.js",
    "build:fx-series": "node scripts/dev/build-fx-series.mjs",
    "test:unit": "JOURNAL_STRICT=on node --test \"tests/unit/**/*.test.mjs\"",
    "test:viz": "JOURNAL_STRICT=on NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test": "npm run test:unit && npm run test:viz",
    "test:all": "npm run test:unit && npm run test:viz",
    "requirements": "node scripts/dev/check-requirements.js",
    "requirements:missing": "node scripts/dev/check-requirements.js --missing",
    "scenario": "node scripts/scenario/run-scenario.mjs",
    "diff": "node scripts/scenario/diff-scenarios.mjs",
    "sweep": "node scripts/scenario/sweep-scenario.mjs",
    "export:tax": "node scripts/tax/export-tax-csv.mjs",
    "crossfoot": "node scripts/tax/crossfoot-drill-reports.mjs",
    "section988:ingest": "node scripts/tax/section988-ingest.mjs",
    "fetch:rates": "node scripts/tax/fetch-fx-rates.mjs",
    "calibrate:fx": "node scripts/lab/calibrate-fx.mjs",
    "probe:residency-cgt": "node scripts/probes/probe-residency-cgt.mjs",
    "probe:foreign-property-cgt": "node scripts/probes/probe-foreign-property-cgt.mjs",
    "probe:tax-payment-leak": "node scripts/probes/probe-tax-payment-tax-leak.mjs",
    "probe:988-method": "node scripts/probes/probe-988-method-dispersion.mjs",
    "verify:harvest": "node scripts/lab/verify-harvest.mjs",
    "votv": "node scripts/lab/votv.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.2",
    "echarts": "^6.1.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "vite": "^8.0.14"
  }
}
